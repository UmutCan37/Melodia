{
  "ConnectionStrings": {
    "Database": "Server=UMUT\\MSSQLSERVER01;Database=MelodiaDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Database",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true,
            "autoCreateSqlDatabase": true
          },
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Melodia.Api"
    }
  },

  "Jwt": {
    "Issuer": "Melodia",
    "Audience": "Melodia.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Storage": {
    "AudioRootPath": "C:\\MelodiaData\\audio",
    "StreamUrlLifetimeMinutes": 5
  },

  "Email": {
    "Host": "localhost",
    "Port": 25,
    "FromAddress": "no-reply@melodia.local",
    "FromName": "Melodia"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "AllowedHosts": "*"
}